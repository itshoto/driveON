SECRET_KEY=change-me-to-a-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=driveon
POSTGRES_USER=driveon
POSTGRES_PASSWORD=driveon
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Path to a Firebase service account JSON (Project Settings > Service
# Accounts > Generate new private key) used to verify frontend ID tokens.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Add GOOGLE_OAUTH_REDIRECT_URI as an authorized
# redirect URI there.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/callback

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

DEFAULT_MAX_GOOGLE_ACCOUNTS=5
DEFAULT_MAX_FILE_SIZE_MB=4096

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
